# Postgres — same database as ledger-core / recon / revenue-rec / integrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledger_core?schema=public"

# Cross-repo bridge to ledger-core's postJournalEntry. fa-amort POSTs
# depreciation JEs here. Same wire contract as recon / revenue-rec.
LEDGER_CORE_URL="http://localhost:3000"
LEDGER_CORE_INTERNAL_TOKEN=""

# Anthropic API key for v0.2 capex classifier (/ai-capex), and later
# useful-life suggestions + impairment indicator detection. Without it
# the classifier page returns a clear "missing key" error; the rest of
# fa-amort (depreciation runs, fixed-asset CRUD) keeps working.
# Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=""

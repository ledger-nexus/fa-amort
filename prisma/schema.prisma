// fa-amort Prisma schema.
//
// Two halves, same pattern as recon / revenue-rec / integrations:
//
//   1. ledger-core mirror — LegalEntity, Book, Account, JournalEntry,
//      JournalLine, Party, Currency, FixedAsset, FixedAssetBookAttributes.
//      Column-for-column with ledger-core's schema. fa-amort does NOT
//      migrate these tables; ledger-core owns them. Read-mostly here;
//      depreciation runs UPDATE FixedAssetBookAttributes.accumulatedDepreciation
//      and .lastDepreciatedThrough as a cross-repo write (v0.1; v0.2 will
//      refactor to an HTTP boundary endpoint on ledger-core).
//
//   2. fa-amort-OWNED — AiAssetSuggestion (audit trail for v0.2's AI
//      classification + useful-life suggestions). v0.1 has zero rows here
//      since AI doesn't fire yet; table exists so v0.2 doesn't need a
//      schema migration.
//
// Mirror discipline: enum-typed columns in ledger-core MUST stay enums
// here (Prisma's db push errors otherwise). recon and revenue-rec already
// learned this the hard way; this schema is built right the first time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ledger-core mirror — DO NOT EDIT without syncing upstream
// =========================================================================

model LegalEntity {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // SECURITY (pen-test pass 4): tenantId added so Server Actions can
  // tenant-scope record lookups.
  tenantId             String  @db.Uuid
  code                 String
  name                 String
  parentEntityId       String? @db.Uuid
  functionalCurrencyId String
  sourceSystem         String?
  sourceRecordType     String?
  sourceRecordId       String?
  sourcePayload        Json?
  mappingVersion       String?
  extensions           Json?

  journalEntries JournalEntry[]
  fixedAssets    FixedAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("legal_entity")
}

model Book {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String    @unique
  name                String
  basis               BookBasis
  reportingCurrencyId String
  isActive            Boolean   @default(true)
  extensions          Json?

  journalEntries           JournalEntry[]
  fixedAssetBookAttributes FixedAssetBookAttributes[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("book")
}

model Account {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId         String?       @db.Uuid
  code             String
  name             String
  type             AccountType
  normalBalance    NormalBalance
  subtype          String?
  isContra         Boolean       @default(false)
  isControlAccount Boolean       @default(false)
  isBank           Boolean       @default(false)
  parentAccountId  String?       @db.Uuid
  bookScope        String[]      @default([])
  active           Boolean       @default(true)

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@map("account")
}

model Party {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId      String? @db.Uuid
  code          String
  displayName   String
  parentPartyId String? @db.Uuid

  fixedAssetVendors FixedAsset[] @relation("FixedAssetVendor")

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@map("party")
}

model Currency {
  code     String  @id
  name     String
  decimals Int     @default(2)
  symbol   String?

  fixedAssetAcquisitions FixedAsset[] @relation("FixedAssetAcqCcy")

  @@map("currency")
}

model JournalEntry {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Phase 4b: entryNumber unique per [tenantId, entryNumber] in ledger-core.
  // No tenantId in this mirror; drop @unique, callers use findFirst.
  entryNumber  String
  entityId     String        @db.Uuid
  entity       LegalEntity   @relation(fields: [entityId], references: [id])
  bookId       String        @db.Uuid
  book         Book          @relation(fields: [bookId], references: [id])
  periodId     String?       @db.Uuid
  documentDate DateTime      @db.Date
  postingDate  DateTime      @db.Date
  memo         String
  currencyId   String
  fxRate       Decimal       @default(1) @db.Decimal(20, 10)
  source       JournalSource @default(MANUAL)
  status       EntryStatus   @default(POSTED)
  reversalOfId String?       @db.Uuid

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([entityId, bookId, documentDate])
  @@map("gl_entry_header")
}

// =========================================================================
// Fixed assets (the substrate models fa-amort reads + drives)
// =========================================================================

model FixedAsset {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])

  code                  String
  description           String
  category              String?
  vendorPartyId         String?          @db.Uuid
  vendor                Party?           @relation("FixedAssetVendor", fields: [vendorPartyId], references: [id])
  acquisitionDate       DateTime         @db.Date
  acquisitionCost       Decimal          @db.Decimal(18, 4)
  acquisitionCurrencyId String
  acquisitionCurrency   Currency         @relation("FixedAssetAcqCcy", fields: [acquisitionCurrencyId], references: [code])
  status                FixedAssetStatus @default(IN_SERVICE)
  disposalDate          DateTime?        @db.Date
  disposalProceeds      Decimal?         @db.Decimal(18, 4)

  assetAccountCode String

  bookAttributes      FixedAssetBookAttributes[]
  aiSuggestions       AiAssetSuggestion[]

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([entityId, status])
  @@map("fixed_asset")
}

enum FixedAssetStatus {
  IN_SERVICE
  IDLE
  DISPOSED
  HELD_FOR_SALE
}

model FixedAssetBookAttributes {
  assetId                 String             @db.Uuid
  asset                   FixedAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  bookId                  String             @db.Uuid
  book                    Book               @relation(fields: [bookId], references: [id])
  usefulLifeMonths        Int
  depreciationMethod      DepreciationMethod
  inServiceDate           DateTime           @db.Date
  salvageValue            Decimal            @default(0) @db.Decimal(18, 4)
  accumulatedDepreciation Decimal            @default(0) @db.Decimal(18, 4)
  lastDepreciatedThrough  DateTime?          @db.Date

  depreciationExpenseAccountCode String
  accumDepreciationAccountCode   String

  @@id([assetId, bookId])
  @@index([bookId, lastDepreciatedThrough])
  @@map("fixed_asset_book_attributes")
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DOUBLE_DECLINING
  MACRS_3_HY
  MACRS_5_HY
  MACRS_7_HY
  MACRS_15_HY
  UNITS_OF_PRODUCTION
  NONE
}

// =========================================================================
// fa-amort-OWNED models
// =========================================================================

// Audit trail for AI-assisted asset workflows (v0.2). Every Claude call
// is logged here whether the human accepts or rejects the suggestion —
// same discipline as recon's AiSuggestion and revenue-rec's
// AiExtractionSuggestion. Pre-creating the table now so v0.2 doesn't
// need a separate schema migration.
//
// kind discriminates between the suggestion types: CAPEX_CLASSIFICATION
// (is this purchase capitalizable?), USEFUL_LIFE (how many months?),
// IMPAIRMENT_INDICATOR (does this text suggest impairment?).
model AiAssetSuggestion {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Nullable because CAPEX_CLASSIFICATION runs BEFORE the asset exists.
  assetId      String?                @db.Uuid
  asset        FixedAsset?            @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// SECURITY (pen-test pass 4 follow-up): tenantId stamped on every new
  /// row from the classifier actions' requireCurrentTenant(). Closes the
  /// "AiAssetSuggestion has no tenant column" gap called out in the
  /// page-level scoping commits — the AI audit pages can now filter
  /// pending rows (assetId still null) by tenant directly.
  ///
  /// Nullable to keep db push non-destructive; backfill via
  /// prisma/backfill-ai-asset-suggestion-tenant.sql. Rows with both
  /// assetId AND tenantId null are unrecoverable — they shipped before
  /// auth landed and have no provenance; the audit page filters them
  /// out.
  tenantId     String?                @db.Uuid
  tenant       Tenant?                @relation(fields: [tenantId], references: [id])

  kind         AiAssetSuggestionKind
  /// Free-form input the model evaluated: a purchase description, invoice
  /// text, news article excerpt, etc.
  inputText    String
  /// The model's structured response. Shape depends on kind.
  outputJson   Json

  modelName        String
  promptHash       String?
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?

  createdAt DateTime @default(now())

  @@index([assetId])
  @@index([kind, createdAt])
  @@index([tenantId, kind, createdAt])
  @@map("ai_asset_suggestion")
}

enum AiAssetSuggestionKind {
  CAPEX_CLASSIFICATION
  USEFUL_LIFE
  IMPAIRMENT_INDICATOR
}

// =========================================================================
// Enums mirrored from ledger-core. MUST stay in sync.
// =========================================================================

enum BookBasis {
  US_GAAP
  US_TAX
  IFRS
  MGMT
  STATUTORY
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalSource {
  MANUAL
  SEED
  SYSTEM
  AI_APPROVED
  IMPORT
}

enum EntryStatus {
  DRAFT
  POSTED
  VOID
  REVERSED
}

// Shared multi-tenancy mirror (pen-test pass 4).
model User {
  id          String  @id @db.Uuid
  email       String  @unique
  displayName String
  isActive    Boolean @default(true)
  memberships TenantMembership[]
  @@map("app_user")
}
model Tenant {
  id                 String              @id @db.Uuid
  slug               String              @unique
  name               String
  /// See ledger-core's Tenant.monthlyAiSpendCapUsd. Read-only here;
  /// fa-amort never writes this column.
  monthlyAiSpendCapUsd Decimal?          @db.Decimal(10, 2)
  memberships        TenantMembership[]
  aiAssetSuggestions AiAssetSuggestion[]
  rateLimitEvents    RateLimitEvent[]
  aiSpendAlerts      AiSpendAlert[]
  @@map("tenant")
}

/// Spend-threshold alerts. One row per (tenant, calendar-month,
/// threshold) — the unique constraint dedupes so each threshold fires
/// exactly once per month, regardless of how many calls happen after
/// the line is crossed.
///
/// fa-amort tracks its own spend independently of recon/revenue-rec.
/// Portfolio-wide aggregation is a known follow-up (would need
/// cross-repo SQL since each AI suggestion table lives in its owning
/// repo's namespace).
///
/// Delivery channels:
///   - Always: row persisted (auditable record)
///   - Always: console.log so deploy-time logs show alerts
///   - Optional: HTTP POST to AI_ALERT_WEBHOOK_URL (Slack-compatible)
model AiSpendAlert {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  /// Companion repo that fired the alert ("recon", "revenue-rec",
  /// "fa-amort"). Part of the unique constraint so each repo
  /// independently tracks its crossings — the three companion repos
  /// share this physical table, and without `source` a 80% crossing
  /// from fa-amort would silently dedupe recon's later 80% crossing
  /// in the same month.
  source    String
  /// Calendar month the alert covers, in YYYY-MM (UTC).
  monthKey  String
  /// Percent of cap that triggered the alert. Today: 80 or 100.
  threshold Int
  /// Cap value at the moment we fired, in USD.
  capUsd    Decimal  @db.Decimal(10, 2)
  /// Spend at the moment we fired, in USD.
  spentUsd  Decimal  @db.Decimal(10, 2)
  sentAt    DateTime @default(now())

  @@unique([tenantId, source, monthKey, threshold])
  @@index([tenantId, sentAt])
  @@map("ai_spend_alert")
}

/// Per-action rate-limit ledger. Each AI Server Action writes one row
/// BEFORE calling Anthropic (success or failure). The helper at
/// src/lib/auth/ai-budget.ts counts rows in the trailing window
/// (per tenant + per user) and refuses if either limit is hit.
///
/// Why a table and not a counter? Audit trail. We can answer "who
/// hit the cap, when, on what action" cheaply. Reaping is a periodic
/// DELETE WHERE createdAt < now() - INTERVAL '7 days' — not done
/// automatically; add a cron when volume justifies it.
model RateLimitEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  /// Clerk user id (the app_user.id resolved by requireCurrentUser).
  /// Nullable so internal/cron AI calls (none today, but for v0.3+)
  /// can still rate-limit at tenant level.
  userId    String?  @db.Uuid
  /// Action identifier, e.g. "classifyCapex", "classifyImpairment",
  /// "classifyUsefulLife". Distinct so per-action limits are possible
  /// — though v0 lumps them all under one "ai" bucket.
  action    String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("rate_limit_event")
}
model TenantMembership {
  tenantId String     @db.Uuid
  userId   String     @db.Uuid
  /// Mirror of ledger-core's TenantRole enum. See src/lib/auth/policy.ts.
  role     TenantRole @default(MEMBER)
  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  @@unique([tenantId, userId])
  @@map("tenant_membership")
}

/// Mirror of ledger-core's TenantRole enum. Must stay in sync —
/// ledger-core's schema is canonical.
enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
